# Source this file after sourcing the existing ARM64 RBT SDK's environment.
_rbt_addons_prefix="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
export PATH="${_rbt_addons_prefix}/@CMAKE_INSTALL_BINDIR@${PATH:+:${PATH}}"
export LD_LIBRARY_PATH="${_rbt_addons_prefix}/@CMAKE_INSTALL_LIBDIR@${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
unset _rbt_addons_prefix
