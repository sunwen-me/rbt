@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(iceoryx2-c 0.10.0 EXACT CONFIG)
find_dependency(iceoryx2-bb-cxx 0.10.0 EXACT CONFIG)
find_dependency(iceoryx2-cxx 0.10.0 EXACT CONFIG)

get_filename_component(_rbt_iceoryx2_prefix "${iceoryx2-cxx_DIR}/../../.." REALPATH)
foreach(_rbt_native_component iceoryx2-c iceoryx2-bb-cxx)
    get_filename_component(_rbt_native_component_prefix
        "${${_rbt_native_component}_DIR}/../../.." REALPATH)
    if(NOT _rbt_native_component_prefix STREQUAL _rbt_iceoryx2_prefix)
        message(FATAL_ERROR "${_rbt_native_component} and iceoryx2-cxx must use the same maintained prefix")
    endif()
endforeach()
get_filename_component(_rbt_expected_native_headers
    "${_rbt_iceoryx2_prefix}/include/iceoryx2/v0.10.0" REALPATH)
foreach(_rbt_native_target iceoryx2-c::includes-only
        iceoryx2-bb-cxx::iceoryx2-bb-cxx iceoryx2-cxx::includes-only-cxx)
    get_target_property(_rbt_native_headers "${_rbt_native_target}" INTERFACE_INCLUDE_DIRECTORIES)
    get_filename_component(_rbt_native_headers "${_rbt_native_headers}" REALPATH)
    if(NOT _rbt_native_headers STREQUAL _rbt_expected_native_headers)
        message(FATAL_ERROR "Already imported native target ${_rbt_native_target} belongs to another baseline")
    endif()
endforeach()
set(_rbt_iceoryx2_provenance "${_rbt_iceoryx2_prefix}/share/rbt/iceoryx2-provenance.toml")
if(NOT EXISTS "${_rbt_iceoryx2_provenance}")
    message(FATAL_ERROR "The selected iceoryx2-cxx prefix has no rbt provenance stamp")
endif()
file(STRINGS "${_rbt_iceoryx2_provenance}" _rbt_iceoryx2_source_diff_line
    REGEX "^source_diff_sha256 = \"[0-9a-fA-F]+\"$")
string(REGEX MATCH "^source_diff_sha256 = \"([0-9a-fA-F]+)\"$"
    _rbt_iceoryx2_source_diff_match "${_rbt_iceoryx2_source_diff_line}")
if(NOT CMAKE_MATCH_1 STREQUAL "@RBT_ICEORYX2_SOURCE_DIFF_SHA256@")
    message(FATAL_ERROR
        "The selected iceoryx2-cxx prefix does not match the rbt SDK source fingerprint"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rbtTargets.cmake")

check_required_components(rbt)
