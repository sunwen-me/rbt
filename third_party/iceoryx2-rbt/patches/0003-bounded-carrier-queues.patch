+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex, MutexGuard};
+
+/// The action taken when a carrier inbox reaches its configured capacity.
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+pub enum OverflowPolicy {
+    /// Keep queued frames and drop the arriving frame.
+    DropNewest,
+    /// Keep the arriving frame and drop the oldest queued frame.
+    DropOldest,
+}
+
+/// Capacity and overflow behavior for each Zenoh channel inbox.
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+pub struct QueueConfig {
+    /// Maximum number of frames held by each inbox.
+    pub capacity: usize,
+    /// How an arriving frame is handled when the inbox is full.
+    pub overflow: OverflowPolicy,
+}
+
+impl QueueConfig {
+    /// The default capacity used by existing carrier constructors.
+    pub const DEFAULT_CAPACITY: usize = 64;
+
+    /// Creates a valid queue configuration.
+    pub fn new(capacity: usize, overflow: OverflowPolicy) -> Result<Self, QueueConfigError> {
+        let config = Self { capacity, overflow };
+        config.validate()?;
+        Ok(config)
+    }
+
+    pub(crate) fn validate(&self) -> Result<(), QueueConfigError> {
+        if self.capacity == 0 {
+            return Err(QueueConfigError::CapacityMustBeNonZero);
+        }
+        Ok(())
+    }
+}
+
+impl Default for QueueConfig {
+    fn default() -> Self {
+        Self {
+            capacity: Self::DEFAULT_CAPACITY,
+            overflow: OverflowPolicy::DropNewest,
+        }
+    }
+}
+
+/// A queue configuration error.
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+pub enum QueueConfigError {
+    /// Queue capacity must be greater than zero.
+    CapacityMustBeNonZero,
+}
+
+impl core::fmt::Display for QueueConfigError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "QueueConfigError::{self:?}")
+    }
+}
+
+impl core::error::Error for QueueConfigError {}
+
+/// A point-in-time snapshot of aggregate carrier inbox counters.
+#[derive(Debug, Default, Eq, PartialEq, Clone, Copy)]
+pub struct QueueStatsSnapshot {
+    /// Frames accepted into inboxes, including arrivals that evicted an older frame.
+    pub accepted: u64,
+    /// Frames removed from inboxes by the carrier.
+    pub popped: u64,
+    /// Arriving frames discarded under [`OverflowPolicy::DropNewest`].
+    pub dropped_newest: u64,
+    /// Previously queued frames evicted under [`OverflowPolicy::DropOldest`].
+    pub dropped_oldest: u64,
+}
+
+#[derive(Default)]
+pub(crate) struct QueueMetrics {
+    counters: Mutex<QueueStatsSnapshot>,
+}
+
+impl QueueMetrics {
+    pub(crate) fn snapshot(&self) -> QueueStatsSnapshot {
+        *lock(&self.counters)
+    }
+
+    fn update(&self, update: impl FnOnce(&mut QueueStatsSnapshot)) {
+        update(&mut lock(&self.counters));
+    }
+}
+
+pub(crate) enum PushOutcome {
+    Accepted,
+    DroppedNewest,
+    DroppedOldest,
+}
+
+pub(crate) struct BoundedQueue<T> {
+    items: Mutex<VecDeque<T>>,
+    config: QueueConfig,
+    metrics: Arc<QueueMetrics>,
+}
+
+impl<T> BoundedQueue<T> {
+    pub(crate) fn new(config: QueueConfig, metrics: Arc<QueueMetrics>) -> Self {
+        debug_assert!(config.validate().is_ok());
+        Self {
+            items: Mutex::new(VecDeque::new()),
+            config,
+            metrics,
+        }
+    }
+
+    pub(crate) fn push(&self, item: T) -> PushOutcome {
+        let mut items = lock(&self.items);
+        if items.len() >= self.config.capacity {
+            match self.config.overflow {
+                OverflowPolicy::DropNewest => {
+                    self.metrics.update(|counters| {
+                        counters.dropped_newest = counters.dropped_newest.saturating_add(1);
+                    });
+                    PushOutcome::DroppedNewest
+                }
+                OverflowPolicy::DropOldest => {
+                    let _ = items.pop_front();
+                    items.push_back(item);
+                    self.metrics.update(|counters| {
+                        counters.accepted = counters.accepted.saturating_add(1);
+                        counters.dropped_oldest = counters.dropped_oldest.saturating_add(1);
+                    });
+                    PushOutcome::DroppedOldest
+                }
+            }
+        } else {
+            items.push_back(item);
+            self.metrics.update(|counters| {
+                counters.accepted = counters.accepted.saturating_add(1);
+            });
+            PushOutcome::Accepted
+        }
+    }
+
+    pub(crate) fn pop(&self) -> Option<T> {
+        let item = lock(&self.items).pop_front();
+        if item.is_some() {
+            self.metrics.update(|counters| {
+                counters.popped = counters.popped.saturating_add(1);
+            });
+        }
+        item
+    }
+
+    #[cfg(test)]
+    fn len(&self) -> usize {
+        lock(&self.items).len()
+    }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        BoundedQueue, OverflowPolicy, QueueConfig, QueueConfigError, QueueMetrics,
+        QueueStatsSnapshot,
+    };
+    use std::sync::Arc;
+
+    #[test]
+    fn rejects_zero_capacity() {
+        assert_eq!(
+            QueueConfig::new(0, OverflowPolicy::DropNewest),
+            Err(QueueConfigError::CapacityMustBeNonZero)
+        );
+    }
+
+    #[test]
+    fn drop_newest_keeps_queued_frames_and_counts_drops() {
+        let metrics = Arc::new(QueueMetrics::default());
+        let queue = BoundedQueue::new(
+            QueueConfig::new(2, OverflowPolicy::DropNewest).unwrap(),
+            metrics.clone(),
+        );
+
+        assert!(matches!(queue.push(1), super::PushOutcome::Accepted));
+        assert!(matches!(queue.push(2), super::PushOutcome::Accepted));
+        assert!(matches!(queue.push(3), super::PushOutcome::DroppedNewest));
+        assert_eq!(queue.pop(), Some(1));
+        assert_eq!(queue.pop(), Some(2));
+        assert_eq!(queue.pop(), None);
+        assert_eq!(
+            metrics.snapshot(),
+            QueueStatsSnapshot {
+                accepted: 2,
+                popped: 2,
+                dropped_newest: 1,
+                dropped_oldest: 0,
+            }
+        );
+    }
+
+    #[test]
+    fn drop_oldest_keeps_arriving_frames_and_counts_evictions() {
+        let metrics = Arc::new(QueueMetrics::default());
+        let queue = BoundedQueue::new(
+            QueueConfig::new(1, OverflowPolicy::DropOldest).unwrap(),
+            metrics.clone(),
+        );
+
+        assert!(matches!(queue.push(1), super::PushOutcome::Accepted));
+        assert!(matches!(queue.push(2), super::PushOutcome::DroppedOldest));
+        assert_eq!(queue.pop(), Some(2));
+        assert_eq!(queue.pop(), None);
+        assert_eq!(
+            metrics.snapshot(),
+            QueueStatsSnapshot {
+                accepted: 2,
+                popped: 1,
+                dropped_newest: 0,
+                dropped_oldest: 1,
+            }
+        );
+    }
+
+    #[test]
+    fn concurrent_pushes_never_exceed_capacity() {
+        const THREADS: usize = 8;
+        const PUSHES_PER_THREAD: usize = 1_000;
+        const CAPACITY: usize = 8;
+
+        for overflow in [OverflowPolicy::DropNewest, OverflowPolicy::DropOldest] {
+            let metrics = Arc::new(QueueMetrics::default());
+            let queue = Arc::new(BoundedQueue::new(
+                QueueConfig::new(CAPACITY, overflow).unwrap(),
+                metrics.clone(),
+            ));
+            let mut threads = Vec::new();
+
+            for thread_id in 0..THREADS {
+                let queue = queue.clone();
+                threads.push(std::thread::spawn(move || {
+                    for item in 0..PUSHES_PER_THREAD {
+                        let _ = queue.push(thread_id * PUSHES_PER_THREAD + item);
+                    }
+                }));
+            }
+
+            for thread in threads {
+                thread.join().unwrap();
+            }
+
+            assert!(queue.len() <= CAPACITY);
+            let snapshot = metrics.snapshot();
+            assert_eq!(
+                snapshot.accepted + snapshot.dropped_newest,
+                (THREADS * PUSHES_PER_THREAD) as u64
+            );
+            if overflow == OverflowPolicy::DropOldest {
+                assert_eq!(
+                    snapshot.dropped_oldest as usize,
+                    THREADS * PUSHES_PER_THREAD - CAPACITY
+                );
+            } else {
+                assert_eq!(snapshot.accepted as usize, CAPACITY);
+            }
+        }
+    }
+}
