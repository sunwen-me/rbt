+            // SAFETY: callers pass a valid, newly-owned descriptor and this wrapper closes it on drop.
+            Self {
+                descriptor: unsafe { FileDescriptor::new_unchecked(descriptor) },
+            }
+        }
+
+        fn raw(&self) -> libc::c_int {
+            // SAFETY: the descriptor remains owned by self and is not closed until self is dropped.
+            unsafe { self.descriptor.native_handle() }
+        }
+    }
+
+    impl FileDescriptorBased for MultiplexedFd {
+        fn file_descriptor(&self) -> &FileDescriptor {
+            &self.descriptor
+        }
+    }
+
+    impl SynchronousMultiplexing for MultiplexedFd {}
+
+    /// Linux local discovery wake source. The inotify fd watches only node-directory
+    /// lifecycle and service-tag changes; pidfds wake when another live node exits.
+    pub struct LocalDiscoveryWake {
+        config: Config,
+        local_node_id: UniqueNodeId,
+        node_dir: PathBuf,
+        service_tag_suffix: Vec<u8>,
+        inotify: MultiplexedFd,
+        root_watch: Option<libc::c_int>,
+        node_watches: HashMap<String, libc::c_int>,
+        pidfds: HashMap<UniqueNodeId, MultiplexedFd>,
+        node_monitor_prefix: Vec<u8>,
+        node_monitor_suffix: Vec<u8>,
+    }
+
+    impl LocalDiscoveryWake {
+        pub fn new(config: &Config, local_node_id: UniqueNodeId) -> anyhow::Result<Self> {
+            let descriptor = unsafe { libc::inotify_init1(libc::IN_NONBLOCK | libc::IN_CLOEXEC) };
+            if descriptor < 0 {
+                return Err(io::Error::last_os_error())
+                    .context("Failed to create the local discovery inotify descriptor");
+            }
+            let mut result = Self {
+                config: config.clone(),
+                local_node_id,
+                node_dir: PathBuf::from(config.global.node_dir().as_str()),
+                service_tag_suffix: config.global.node.service_tag_suffix.as_bytes().to_vec(),
+                inotify: MultiplexedFd::from_owned_fd(descriptor),
+                root_watch: None,
+                node_watches: HashMap::new(),
+                pidfds: HashMap::new(),
+                node_monitor_prefix: config.global.prefix.as_bytes().to_vec(),
+                node_monitor_suffix: config.global.node.monitor_suffix.as_bytes().to_vec(),
+            };
+            // Install the root watch before scanning, then scan again after installing
+            // per-node watches to close the initial discovery race.
+            result.ensure_root_watch()?;
+            result.refresh(&[])?;
+            Ok(result)
+        }
+
+        pub fn attach<'w>(
+            &'w self,
+            waitset: &'w WaitSet<ipc::Service>,
+        ) -> anyhow::Result<LocalAttached<'w>> {
+            let inotify = waitset
+                .attach_notification(&self.inotify)
+                .map_err(|error| anyhow!("Failed to attach inotify to the wait set: {error:?}"))?;
+            let mut pidfds = Vec::with_capacity(self.pidfds.len());
+            for (node_id, descriptor) in &self.pidfds {
+                let guard = waitset.attach_notification(descriptor).map_err(|error| {
+                    anyhow!("Failed to attach pidfd for node {node_id}: {error:?}")
+                })?;
+                pidfds.push((*node_id, guard));
+            }
+            Ok(LocalAttached { inotify, pidfds })
+        }
+
+        /// Refreshes node watches and pidfds after a wake. `exited` contains pidfds
+        /// that became readable in the just-completed wait iteration.
+        pub fn refresh(&mut self, exited: &[UniqueNodeId]) -> anyhow::Result<bool> {
+            let mut discover = false;
+            let exited: HashSet<_> = exited.iter().copied().collect();
+            for node_id in &exited {
+                if self.pidfds.remove(node_id).is_some() {
+                    discover = true;
+                }
+            }
+
+            // Drain, scan, and reconcile until the queue is quiet. Any root event
+            // consumed during a scan is followed by another directory scan, so a
+            // node created before Node::list reports it Alive still gets watched.
+            loop {
+                let (_, relevant) = self.read_event_batch()?;
+                discover |= relevant;
+                self.ensure_root_watch()?;
+                let live_nodes = self.live_nodes()?;
+                let node_directories = self.node_directories()?;
+                for node_id in &exited {
+                    if live_nodes.contains_key(node_id) {
+                        anyhow::bail!(
+                            "pidfd for node {node_id} became readable while Node::list still reports it alive"
+                        );
+                    }
+                }
+                let (watch_discover, rescan) = self.reconcile_node_watches(&node_directories)?;
+                discover |= watch_discover;
+                discover |= self.reconcile_pidfds(&live_nodes, &exited)?;
+
+                let (events_seen, relevant) = self.read_event_batch()?;
+                discover |= relevant;
+                if !events_seen && !rescan {
+                    break;
+                }
+            }
+            Ok(discover)
+        }
+
+        fn ensure_root_watch(&mut self) -> anyhow::Result<()> {
+            if self.root_watch.is_none() {
+                self.root_watch = Some(self.add_watch(&self.node_dir)?);
+            }
+            Ok(())
+        }
+
+        fn live_nodes(&self) -> anyhow::Result<HashMap<UniqueNodeId, Option<ProcessId>>> {
+            let mut ids = Vec::new();
+            Node::<ipc::Service>::list(&self.config, |state| {
+                if matches!(&state, NodeState::Alive(_)) {
+                    ids.push(*state.node_id());
+                }
+                CallbackProgression::Continue
+            })
+            .map_err(|error| {
+                anyhow!("Failed to list local nodes for reactive discovery: {error:?}")
+            })?;
+
+            let mut nodes = HashMap::with_capacity(ids.len());
+            for node_id in ids {
+                let pid = if node_id == self.local_node_id {
+                    None
+                } else {
+                    Some(node_id.pid::<ipc::Service>().map_err(|error| {
+                        anyhow!("Failed to read the process id for node {node_id}: {error:?}")
+                    })?)
+                };
+                nodes.insert(node_id, pid);
+            }
+            Ok(nodes)
+        }
+
+        fn node_directories(&self) -> anyhow::Result<HashSet<String>> {
+            let entries = fs::read_dir(&self.node_dir).with_context(|| {
+                format!(
+                    "Failed to scan local node directory {}",
+                    self.node_dir.display()
+                )
+            })?;
+            let mut node_directories = HashSet::new();
+            for entry in entries {
+                let entry = entry.context("Failed to read an entry in the local node directory")?;
+                let name = entry.file_name();
+                let Some(name) = name.to_str() else {
+                    continue;
+                };
+                if name.parse::<u128>().is_err() {
+                    continue;
+                }
+                match entry.file_type() {
+                    Ok(file_type) if file_type.is_dir() => {
+                        node_directories.insert(name.to_owned());
+                    }
+                    Ok(_) => (),
+                    Err(error) if error.raw_os_error() == Some(libc::ENOENT) => (),
+                    Err(error) => {
+                        return Err(error).with_context(|| {
+                            format!("Failed to inspect node directory entry {name:?}")
+                        });
+                    }
+                }
+            }
+            Ok(node_directories)
+        }
+
+        fn reconcile_node_watches(
+            &mut self,
+            node_directories: &HashSet<String>,
+        ) -> anyhow::Result<(bool, bool)> {
+            let removed: Vec<_> = self
+                .node_watches
+                .keys()
+                .filter(|name| !node_directories.contains(*name))
+                .cloned()
+                .collect();
+            let removed_any = !removed.is_empty();
+            let mut discover = false;
+            let mut rescan = false;
+            for node_id in removed {
+                if let Some(watch) = self.node_watches.remove(&node_id) {
+                    self.remove_watch(watch)?;
+                }
+            }
+
+            if removed_any {
+                // Consume IN_IGNORED before adding watches, so a reused watch
+                // descriptor cannot be mistaken for an older node directory.
+                let (events_seen, relevant) = self.read_event_batch()?;
+                rescan |= events_seen;
+                discover |= relevant;
+            }
+
+            for name in node_directories {
+                if self.node_watches.contains_key(name) {
+                    continue;
+                }
+                let path = self.node_dir.join(name);
+                match self.add_watch(&path) {
+                    Ok(watch) => {
+                        self.node_watches.insert(name.clone(), watch);
+                    }
+                    Err(error) if error.raw_os_error() == Some(libc::ENOENT) => {
+                        // The root watch observes a node directory created after
+                        // this scan. A removed directory is rechecked on the next pass.
+                        discover = true;
+                    }
+                    Err(error) => {
+                        return Err(error)
+                            .with_context(|| format!("Failed to watch node directory {name:?}"));
+                    }
+                }
+            }
+            Ok((discover, rescan))
+        }
+
+        fn reconcile_pidfds(
+            &mut self,
+            live_nodes: &HashMap<UniqueNodeId, Option<ProcessId>>,
+            exited: &HashSet<UniqueNodeId>,
+        ) -> anyhow::Result<bool> {
+            self.pidfds
+                .retain(|node_id, _| live_nodes.contains_key(node_id) && !exited.contains(node_id));
+
+            let mut discover = false;
+            for (node_id, pid) in live_nodes {
+                let Some(pid) = pid else {
+                    continue;
+                };
+                if self.pidfds.contains_key(node_id) || exited.contains(node_id) {
+                    continue;
+                }
+
+                let raw_descriptor =
+                    unsafe { libc::syscall(libc::SYS_pidfd_open, pid.value(), 0) as libc::c_int };
+                if raw_descriptor < 0 {
+                    let error = io::Error::last_os_error();
+                    if error.raw_os_error() == Some(libc::ESRCH) {
+                        if self.node_is_alive(*node_id)? {
+                            return Err(error).with_context(|| {
+                                format!(
+                                    "pidfd_open reported an exited process but node {node_id} is still alive"
+                                )
+                            });
+                        }
+                        discover = true;
+                        continue;
+                    }
+                    return Err(error)
+                        .with_context(|| format!("Failed to open a pidfd for node {node_id}"));
+                }
+
+                let descriptor = MultiplexedFd::from_owned_fd(raw_descriptor);
+                // Recheck after pidfd_open so a recycled PID cannot stand in for
+                // the process associated with this UniqueNodeId.
+                if !self.node_is_alive(*node_id)? {
+                    discover = true;
+                    continue;
+                }
+                self.pidfds.insert(*node_id, descriptor);
+            }
+            Ok(discover)
+        }
+
+        fn node_is_alive(&self, node_id: UniqueNodeId) -> anyhow::Result<bool> {
+            let state = Node::<ipc::Service>::state_of(&self.config, node_id).map_err(|error| {
+                anyhow!("Failed to recheck node {node_id} after pidfd registration: {error:?}")
+            })?;
+            Ok(matches!(state, Some(NodeState::Alive(_))))
+        }
+
+        fn add_watch(&self, path: &Path) -> io::Result<libc::c_int> {
+            let path = CString::new(path.as_os_str().as_bytes())
+                .map_err(|error| io::Error::new(io::ErrorKind::InvalidInput, error))?;
+            let watch =
+                unsafe { libc::inotify_add_watch(self.inotify.raw(), path.as_ptr(), WATCH_MASK) };
+            if watch < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(watch)
+        }
+
+        fn remove_watch(&self, watch: libc::c_int) -> io::Result<()> {
+            if unsafe { libc::inotify_rm_watch(self.inotify.raw(), watch) } == 0 {
+                return Ok(());
+            }
+            let error = io::Error::last_os_error();
+            if error.raw_os_error() == Some(libc::EINVAL) {
+                return Ok(());
+            }
+            Err(error)
+        }
+
+        #[cfg(test)]
+        fn read_events(&mut self) -> anyhow::Result<bool> {
+            self.read_event_batch().map(|(_, relevant)| relevant)
+        }
+
+        fn read_event_batch(&mut self) -> anyhow::Result<(bool, bool)> {
+            let mut events_seen = false;
+            let mut relevant = false;
+            let mut buffer = [0u8; 8192];
+            loop {
+                let bytes_read = unsafe {
+                    libc::read(self.inotify.raw(), buffer.as_mut_ptr().cast(), buffer.len())
+                };
+                if bytes_read < 0 {
+                    let error = io::Error::last_os_error();
+                    match error.raw_os_error() {
+                        Some(libc::EINTR) => continue,
+                        Some(libc::EAGAIN) => break,
+                        _ => return Err(error).context("Failed to read local discovery events"),
+                    }
+                }
+                if bytes_read == 0 {
+                    break;
+                }
+
+                events_seen = true;
+                let bytes_read = bytes_read as usize;
+                let mut offset = 0;
+                while offset < bytes_read {
+                    let header_size = size_of::<libc::inotify_event>();
+                    if bytes_read - offset < header_size {
+                        return Err(anyhow!("Truncated inotify event header"));
+                    }
+                    // SAFETY: the read buffer contains at least a complete inotify_event header;
+                    // read_unaligned handles the byte buffer's alignment.
+                    let event = unsafe {
+                        ptr::read_unaligned(
+                            buffer.as_ptr().add(offset).cast::<libc::inotify_event>(),
+                        )
+                    };
+                    let event_size = header_size + event.len as usize;
+                    if event_size > bytes_read - offset {
+                        return Err(anyhow!("Truncated inotify event name"));
+                    }
+                    let name_start = offset + header_size;
+                    let name_end = name_start + event.len as usize;
+                    let name = buffer[name_start..name_end]
+                        .split(|byte| *byte == 0)
+                        .next()
+                        .unwrap_or_default();
+                    relevant |= self.handle_event(event.wd, event.mask, name);
+                    offset += event_size;
+                }
+            }
+            Ok((events_seen, relevant))
+        }
+
+        fn handle_event(&mut self, watch: libc::c_int, mask: u32, name: &[u8]) -> bool {
+            if mask & libc::IN_IGNORED != 0 {
+                if self.root_watch == Some(watch) {
+                    self.root_watch = None;
+                }
+                self.node_watches.retain(|_, value| *value != watch);
+                return false;
+            }
+            if mask & libc::IN_Q_OVERFLOW != 0 {
+                return true;
+            }
+
+            if self.root_watch == Some(watch) {
+                if mask & (libc::IN_DELETE_SELF | libc::IN_MOVE_SELF) != 0 {
+                    self.root_watch = None;
+                    return true;
+                }
+                if mask & WATCH_EVENTS == 0 {
+                    return false;
+                }
+                return mask & libc::IN_ISDIR != 0 || self.is_node_monitor_file(name);
+            }
+
+            if self.node_watches.values().any(|value| *value == watch) {
+                if mask & (libc::IN_DELETE_SELF | libc::IN_MOVE_SELF) != 0 {
+                    return true;
+                }
+                return mask & WATCH_EVENTS != 0 && name.ends_with(&self.service_tag_suffix);
+            }
+            false
+        }
+
+        fn is_node_monitor_file(&self, name: &[u8]) -> bool {
+            let Some(name) = name.strip_suffix(self.node_monitor_suffix.as_slice()) else {
+                return false;
+            };
+            let Some(node_id) = name.strip_prefix(self.node_monitor_prefix.as_slice()) else {
+                return false;
+            };
+            !node_id.is_empty() && node_id.iter().all(u8::is_ascii_digit)
+        }
+
+        #[cfg(test)]
+        fn descriptor_count(&self) -> usize {
+            1 + self.node_watches.len() + self.pidfds.len()
+        }
+    }
+
+    pub struct LocalAttached<'w> {
+        pub inotify: WaitSetGuard<'w, 'w, ipc::Service>,
+        pub pidfds: Vec<(UniqueNodeId, WaitSetGuard<'w, 'w, ipc::Service>)>,
+    }
