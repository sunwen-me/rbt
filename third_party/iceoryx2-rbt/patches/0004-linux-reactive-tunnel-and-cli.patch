+        #[test]
+        fn sigkill_node_exit_is_observed_by_pidfd() {
+            use std::process::{Command, Stdio};
+
+            let root = test_root();
+            fs::create_dir_all(&root).unwrap();
+            let mut config = Config::default();
+            config
+                .global
+                .set_root_path(&IoxPath::new(root.to_str().unwrap().as_bytes()).unwrap());
+            let local = NodeBuilder::new()
+                .config(&config)
+                .create::<ipc::Service>()
+                .unwrap();
+            let child = Command::new(std::env::current_exe().unwrap())
+                .arg("--exact")
+                .arg("wake::linux::tests::sigkill_node_exit_child")
+                .arg("--nocapture")
+                .env("IOX2_WAKE_TEST_ROOT", &root)
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .spawn()
+                .unwrap();
+            let mut child = child;
+            let child_ready = root.join("child-ready");
+            let deadline = Instant::now() + Duration::from_secs(5);
+            while !child_ready.exists() && Instant::now() < deadline {
+                if let Some(status) = child.try_wait().unwrap() {
+                    panic!("watcher child exited before creating its node: {status}");
+                }
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            assert!(child_ready.exists(), "watcher child did not become ready");
+
+            let child_pid = child.id() as libc::pid_t;
+            let mut child_node_id = None;
+            Node::<ipc::Service>::list(&config, |state| {
+                if matches!(&state, NodeState::Alive(_)) {
+                    let node_id = *state.node_id();
+                    if node_id
+                        .pid::<ipc::Service>()
+                        .is_ok_and(|pid| pid.value() == child_pid)
+                    {
+                        child_node_id = Some(node_id);
+                    }
+                }
+                CallbackProgression::Continue
+            })
+            .unwrap();
+            let child_node_id = child_node_id.expect("child node should be listed as alive");
+
+            let mut wake = LocalDiscoveryWake::new(&config, *local.id()).unwrap();
+            assert!(wake.pidfds.contains_key(&child_node_id));
+            child.kill().unwrap();
+            let _ = child.wait().unwrap();
+
+            let child_pidfd_ready = {
+                let waitset = WaitSetBuilder::new().create::<ipc::Service>().unwrap();
+                let attached = wake.attach(&waitset).unwrap();
+                let mut child_pidfd_ready = false;
+                waitset
+                    .wait_and_process_once_with_timeout(
+                        |attachment_id| {
+                            if attached.pidfds.iter().any(|(node_id, guard)| {
+                                *node_id == child_node_id && attachment_id.has_event_from(guard)
+                            }) {
+                                child_pidfd_ready = true;
+                            }
+                            CallbackProgression::Continue
+                        },
+                        Duration::from_secs(5),
+                    )
+                    .unwrap();
+                child_pidfd_ready
+            };
+            assert!(child_pidfd_ready, "child pidfd should wake the wait set");
+            assert!(wake.refresh(&[child_node_id]).unwrap());
+            assert!(!wake.pidfds.contains_key(&child_node_id));
+
+            drop(wake);
+            drop(local);
+            fs::remove_dir_all(root).unwrap();
+        }
+
+        #[test]
+        fn sigkill_node_exit_child() {
+            let Ok(root) = std::env::var("IOX2_WAKE_TEST_ROOT") else {
+                return;
+            };
+            let mut config = Config::default();
+            config
+                .global
+                .set_root_path(&IoxPath::new(root.as_bytes()).unwrap());
+            let node = NodeBuilder::new()
+                .config(&config)
+                .create::<ipc::Service>()
+                .unwrap();
+            fs::write(
+                PathBuf::from(root).join("child-ready"),
+                node.id().to_string(),
+            )
+            .unwrap();
+            loop {
+                std::thread::park();
+            }
+        }
+
+        fn open_fd_count() -> usize {
+            fs::read_dir("/proc/self/fd").unwrap().count()
+        }
     }
 }
