+        #[test]
+        fn startup_watches_existing_nodes_and_drop_releases_descriptors() {
+            const CHILD_GUARD: &str = "IOX2_WAKE_FD_CLEANUP_TEST_CHILD";
+            if std::env::var_os(CHILD_GUARD).is_none() {
+                let status = std::process::Command::new(std::env::current_exe().unwrap())
+                    .arg("--exact")
+                    .arg("wake::linux::tests::startup_watches_existing_nodes_and_drop_releases_descriptors")
+                    .arg("--nocapture")
+                    .env(CHILD_GUARD, "1")
+                    .status()
+                    .unwrap();
+                assert!(status.success(), "FD cleanup child test failed: {status}");
+                return;
+            }
+
+            let root = test_root();
+            fs::create_dir_all(&root).unwrap();
+            let mut config = Config::default();
+            config
+                .global
+                .set_root_path(&IoxPath::new(root.to_str().unwrap().as_bytes()).unwrap());
+            let node = NodeBuilder::new()
+                .config(&config)
+                .create::<ipc::Service>()
+                .unwrap();
+            let existing_service = node
+                .service_builder(&ServiceName::new("existing.service").unwrap())
+                .publish_subscribe::<u64>()
+                .create()
+                .unwrap();
+            let id = *node.id();
+            let descriptors_before = open_fd_count();
+
+            let mut wake = LocalDiscoveryWake::new(&config, id).unwrap();
+            assert!(wake.descriptor_count() >= 2);
+            assert!(!wake.refresh(&[]).unwrap());
+
+            {
+                let waitset = WaitSetBuilder::new().create::<ipc::Service>().unwrap();
+                let _attached = wake.attach(&waitset).unwrap();
+                let mut woke = false;
+                waitset
+                    .wait_and_process_once_with_timeout(
+                        |_| {
+                            woke = true;
+                            CallbackProgression::Continue
+                        },
+                        Duration::from_millis(30),
+                    )
+                    .unwrap();
+                assert!(!woke, "ordinary discovery reads must not trigger a wake");
+            }
+
+            drop(wake);
+            assert_eq!(open_fd_count(), descriptors_before);
+            drop(existing_service);
+            drop(node);
+            fs::remove_dir_all(root).unwrap();
+        }
