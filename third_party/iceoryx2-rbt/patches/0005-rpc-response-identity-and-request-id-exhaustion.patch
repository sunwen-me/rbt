diff --git a/iceoryx2/src/port/client.rs b/iceoryx2/src/port/client.rs
index b5569f102..f692e0d4a 100644
--- a/iceoryx2/src/port/client.rs
+++ b/iceoryx2/src/port/client.rs
@@ -171,6 +171,38 @@ impl core::fmt::Display for RequestSendError {
 
 impl core::error::Error for RequestSendError {}
 
+fn try_next_request_id(request_id_counter: &AtomicU64) -> Option<RequestId> {
+    let request_id = request_id_counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+            if value < RequestId::max_value() {
+                Some(value + 1)
+            } else {
+                None
+            }
+        })
+        .ok()?;
+
+    RequestId::new(request_id).ok()
+}
+
+#[cfg(test)]
+mod request_id_tests {
+    use super::*;
+
+    #[test]
+    fn request_id_counter_stops_at_max_value_without_wrapping() {
+        let max_value = RequestId::max_value();
+        let request_id_counter = AtomicU64::new(max_value - 1);
+
+        assert_eq!(
+            try_next_request_id(&request_id_counter).unwrap().value(),
+            max_value - 1
+        );
+        assert!(try_next_request_id(&request_id_counter).is_none());
+        assert_eq!(request_id_counter.load(Ordering::Relaxed), max_value);
+    }
+}
+
