from __future__ import annotations

from dataclasses import dataclass

class TfError(Exception):
    code: str
    def __init__(self, code: str, message: str = ...) -> None: ...

@dataclass(frozen=True, slots=True)
class FrameId:
    value: str
    def __init__(self, value: str) -> None: ...
    @classmethod
    def from_bytes(cls, value: bytes | bytearray | memoryview) -> FrameId: ...
    def to_bytes(self) -> bytes: ...
    def __str__(self) -> str: ...

@dataclass(frozen=True, slots=True)
class Vec3:
    x: float
    y: float
    z: float
    def __init__(self, x: float, y: float, z: float) -> None: ...

@dataclass(frozen=True, slots=True)
class Quaternion:
    x: float
    y: float
    z: float
    w: float
    def __init__(self, x: float, y: float, z: float, w: float) -> None: ...
    @classmethod
    def identity(cls) -> Quaternion: ...

@dataclass(frozen=True, slots=True)
class Transform3:
    translation: Vec3
    rotation: Quaternion
    def __init__(self, translation: Vec3, rotation: Quaternion) -> None: ...
    @classmethod
    def identity(cls) -> Transform3: ...
    def inverse(self) -> Transform3: ...
    def compose(self, other: Transform3) -> Transform3: ...
    def apply_point(self, point: Vec3) -> Vec3: ...
    def apply_vector(self, vector: Vec3) -> Vec3: ...
    def apply_pose(self, pose: Pose3) -> Pose3: ...
    def interpolate(self, other: Transform3, amount: float) -> Transform3: ...

@dataclass(frozen=True, slots=True)
class Pose3:
    position: Vec3
    orientation: Quaternion
    def __init__(self, position: Vec3, orientation: Quaternion) -> None: ...
