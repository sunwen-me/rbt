@dataclass(frozen=True)
class RpcDescriptor:
    service_name: str
    request_type: MessageTypeDescriptor
    response_type: MessageTypeDescriptor
    transport: RpcTransportFeatures = ...
    resources: RpcResourceConfig = ...
    @property
    def request(self) -> MessageTypeDescriptor: ...
    @property
    def response(self) -> MessageTypeDescriptor: ...
    @classmethod
    def from_dict(cls, value: dict[str, Any]) -> RpcDescriptor: ...
    @classmethod
    def from_json(cls, value: str | bytes | bytearray) -> RpcDescriptor: ...
    @classmethod
    def fixed(
        cls,
        service_name: str,
        request_type: MessageTypeDescriptor | dict[str, Any] | Any,
        response_type: MessageTypeDescriptor | dict[str, Any] | Any,
        *,
        resources: RpcResourceConfig | None = ...,
        transport: RpcTransportFeatures | None = ...,
    ) -> RpcDescriptor: ...
    for_fixed = fixed
    @classmethod
    def fixed_slice(
        cls,
        service_name: str,
        request_type: MessageTypeDescriptor | dict[str, Any] | Any,
        response_type: MessageTypeDescriptor | dict[str, Any] | Any,
        *,
        resources: RpcResourceConfig | None = ...,
        transport: RpcTransportFeatures | None = ...,
    ) -> RpcDescriptor: ...
    for_fixed_slice = fixed_slice
    fixed_to_slice = fixed_slice
    @classmethod
    def slice_fixed(
        cls,
        service_name: str,
        request_type: MessageTypeDescriptor | dict[str, Any] | Any,
        response_type: MessageTypeDescriptor | dict[str, Any] | Any,
        *,
        resources: RpcResourceConfig | None = ...,
        transport: RpcTransportFeatures | None = ...,
    ) -> RpcDescriptor: ...
    for_slice_fixed = slice_fixed
    slice_to_fixed = slice_fixed
    @classmethod
    def slice(
        cls,
        service_name: str,
        request_type: MessageTypeDescriptor | dict[str, Any] | Any,
        response_type: MessageTypeDescriptor | dict[str, Any] | Any,
        *,
        resources: RpcResourceConfig | None = ...,
        transport: RpcTransportFeatures | None = ...,
    ) -> RpcDescriptor: ...
    for_slice = slice
    slice_to_slice = slice
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...

