class RpcClient:
    descriptor: RpcDescriptor
    provider_component_id: str | None
    capability_instance_id: str | None
    activation_id: int | None
    @classmethod
    def open(cls, descriptor: RpcDescriptor) -> RpcClient: ...
    def loan_request(self, element_count: int | None = ...) -> RpcRequestLoan: ...
    def call(
        self,
        fill: Any = ...,
        *,
        timeout: float = ...,
        element_count: int | None = ...,
    ) -> RpcResponse: ...
    async def call_async(
        self,
        fill: Any = ...,
        *,
        timeout: float | None = ...,
        element_count: int | None = ...,
    ) -> RpcResponse: ...
    def _debug_async_registration_count(self) -> int: ...
    @property
    def pressure(self) -> RpcPressure: ...
    def close(self) -> None: ...

