class Component:
    def prepare(self, config: Any) -> None: ...
    def activate(self, ctx: ActivationContext) -> None: ...

class TaskContext:
    @property
    def cancelled(self) -> bool: ...
    def is_cancelled(self) -> bool: ...

class AsyncTaskHandle:
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...
    @property
    def done(self) -> bool: ...

class ActivationContext:
    @property
    def component_id(self) -> str: ...
    @property
    def process_instance_id(self) -> str: ...
    @property
    def activation_id(self) -> int: ...
    @property
    def component(self) -> str: ...
    @property
    def process_instance(self) -> str: ...
    @property
    def cancelled(self) -> bool: ...
    def require(
        self, name: str, *, max_borrowed: int | None = ...
    ) -> ImageSubscriber | PointCloudSubscriber | RpcClient: ...
    def require_rpc(self, name: str) -> RpcClient: ...
    def provide_dynamic_tf(self, capability_type: str) -> _DynamicTfPublisher: ...
    def provide_static_tf(
        self,
        update_role: str,
        snapshot_role: str,
        initial: _StaticSet,
        maximum_transforms: int,
    ) -> _StaticTfProvider: ...
    def require_dynamic_tf(
        self, requirement: str, slot: str, buffer: _TransformBuffer
    ) -> _DynamicTfSubscriber: ...
    def require_static_tf(
        self,
        update_requirement: str,
        snapshot_requirement: str,
        slot: str,
        buffer: _TransformBuffer,
        maximum_transforms: int,
    ) -> _StaticTfClient: ...
    def provide_image(
        self,
        capability_type: str,
        *,
        maximum_payload_bytes: int = ...,
        max_loans: int | None = ...,
        max_borrowed: int | None = ...,
    ) -> ImagePublisher: ...
    def provide_point_cloud(
        self,
        capability_type: str,
        *,
        maximum_points: int = ...,
        max_loans: int | None = ...,
        max_borrowed: int | None = ...,
    ) -> PointCloudPublisher: ...
    def provide_rpc(self, capability_type: str, descriptor: RpcDescriptor) -> RpcServer: ...
    def spawn_critical(self, name: str, callable: Any) -> Any: ...
    def spawn_background(self, name: str, callable: Any) -> Any: ...
    def spawn_critical_async(
        self, name: str, coroutine_function: Any, *args: Any
    ) -> AsyncTaskHandle: ...
    def spawn_background_async(
        self, name: str, coroutine_function: Any, *args: Any
    ) -> AsyncTaskHandle: ...

class MessageShape(str, Enum):
