// Native hardware telemetry. SI units; HostMonotonic receive timestamps.
package rbt.hardware;
abi 1;

struct Stamp {
    source_id: u8[48];
    generation: u64;
    nanoseconds: i64;
    kind: u32; // 1 = HostMonotonic, matching the existing navigation Stamp.
    reserved: u32;
}
message Imu {
    stamp: Stamp;
    sequence: u64;
    frame: u8[64];
    orientation_x: f64;
    orientation_y: f64;
    orientation_z: f64;
    orientation_w: f64;
    angular_velocity_x: f64;
    angular_velocity_y: f64;
    angular_velocity_z: f64;
    linear_acceleration_x: f64;
    linear_acceleration_y: f64;
    linear_acceleration_z: f64;
    orientation_covariance: f64[9];
    angular_velocity_covariance: f64[9];
    linear_acceleration_covariance: f64[9];
}
// Published only for a newly received, healthy pair of wheel feedbacks.
message WheelOdometry {
    stamp: Stamp;
    sequence: u64;
    frame: u8[64];
    child_frame: u8[64];
    x: f64;
    y: f64;
    yaw: f64;
    linear_x: f64;
    angular_z: f64;
    left_rpm: f64;
    right_rpm: f64;
}
// Diagnostic only. Never replaces command expiry or hardware safety.
message BaseStatus {
    stamp: Stamp;
    sequence: u64;
    rejected_commands: u64;
    io_failures: u64;
    watchdog_expired: u32;
    emergency_stop: u32;
    io_fault: u32;
    feedback_fresh: u32;
    left_motor_command: i32;
    right_motor_command: i32;
}
