// Driver-local canonical RPC contracts. Frozen framework schemas are unchanged.
package rbt.orbbec;
abi 1;

message CameraInfoRequest {
    stream: u32;
    reserved: u32;
}

message CameraInfoResponse {
    status: u32;
    stream: u32;
    width: u32;
    height: u32;
    fps: u32;
    format: u32;
    fx: f64;
    fy: f64;
    cx: f64;
    cy: f64;
    distortion_model: u32;
    reserved: u32;
    distortion: f64[8];
    frame_id: u8[64];
    serial: u8[64];
}

message ControlRequest {
    operation: u32;
    property: u32;
    value: i32;
    reserved: u32;
}

message ControlResponse {
    status: u32;
    value: i32;
    message: u8[128];
}
