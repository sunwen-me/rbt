// Navigation-local native ABI. Domain vectors/shared_ptr never cross processes.
package rbt.navwire;
abi 1;

struct Stamp {
    source_id: u8[48];
    generation: u64;
    nanoseconds: i64;
    kind: u32;
    reserved: u32;
}
message Odom2D {
    stamp: Stamp;
    sequence: u64;
    linear_x: f64;
    angular_z: f64;
}
message GoalCommand {
    stamp: Stamp;
    goal_id: u64;
    operation: u32;
    reserved: u32;
    x: f64;
    y: f64;
    yaw: f64;
    timeout_ns: i64;
}
message NavigationStatus {
    stamp: Stamp;
    goal_id: u64;
    map_version: u64;
    state: u32;
    error: u32;
}
struct MapHeader {
    stamp: Stamp;
    version: u64;
    width: u32;
    height: u32;
    resolution: f64;
    origin_x: f64;
    origin_y: f64;
    origin_yaw: f64;
    frame: u8[64];
}
message OccupancyMap = slice {
    header MapHeader;
    payload i8[];
}
struct PathPoint {
    x: f64;
    y: f64;
    yaw: f64;
}
struct PathHeader {
    stamp: Stamp;
    goal_id: u64;
    map_version: u64;
    frame: u8[64];
}
message PlannedPath = slice {
    header PathHeader;
    payload PathPoint[];
}
message VelocityCommand {
    stamp: Stamp;
    source_id: u64;
    sequence: u64;
    valid_until_ns: i64;
    linear_x: f64;
    angular_z: f64;
}
message EmergencyStop {
    stamp: Stamp;
    source_id: u64;
    sequence: u64;
    active: u32;
    reserved: u32;
}
// Diagnostic only: the base must enforce its own deadline, never trust this
// heartbeat in place of checking the final VelocityCommand.
message GuardState {
    stamp: Stamp;
    sequence: u64;
    allowed_source: u64;
    output_source: u64;
    rejected_commands: u64;
    watchdog_expired: u32;
    emergency_stop: u32;
}
message BaseState {
    stamp: Stamp;
    sequence: u64;
    x: f64;
    y: f64;
    yaw: f64;
    linear_x: f64;
    angular_z: f64;
    rejected_commands: u64;
    watchdog_expired: u32;
    emergency_stop: u32;
}
// Atomic, optional SuperLIO navigation output. Existing LIO capabilities remain
// unchanged. stamp is the identified host-monotonic estimation epoch; it is
// derived from MID360 host receipt time in the currently supported mode 0,
// not a claim of hardware capture time. All poses/points use metres, xyzw
// quaternions and rad/s. flags bit 0 asserts a valid map<-odom transform.
struct LioFrameHeader {
    stamp: Stamp;
    sequence: u64;
    uncertainty_ns: u64;
    flags: u32;
    reserved: u32;
    world_frame: u8[64];
    base_frame: u8[64];
    odom_base_position: f64[3];
    odom_base_quaternion_xyzw: f64[4];
    map_odom_position: f64[3];
    map_odom_quaternion_xyzw: f64[4];
    sensor_origin: f64[3];
    linear_velocity: f64[3];
    angular_velocity: f64[3];
}
// Same XYZI fields as rbt.sensor.PointXYZI; declared here because the current
// IDL has no cross-package import. The generated descriptor owns this ABI.
struct LioPoint {
    x: f32;
    y: f32;
    z: f32;
    intensity: f32;
}
message LioNavigationFrame = slice {
    header LioFrameHeader;
    payload LioPoint[];
}
