+bool PriorMapLocalization::navigationReady() const noexcept
+{
+  if (!navigation_tracking_.load(std::memory_order_acquire)) {
+    return false;
+  }
+  const auto last_accepted =
+      navigation_last_accepted_steady_ns_.load(std::memory_order_acquire);
+  if (last_accepted <= 0) {
+    return false;
+  }
+  const auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count();
+  constexpr std::int64_t kNavigationLocalizationFreshnessNs = 2'000'000'000LL;
+  return now >= last_accepted && now - last_accepted <= kNavigationLocalizationFreshnessNs;
+}
