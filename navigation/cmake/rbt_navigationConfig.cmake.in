@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@RBT_NAVIGATION_NATIVE@)
    find_dependency(rbt CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/rbtNavigationTargets.cmake")
if("map_io" IN_LIST rbt_navigation_FIND_COMPONENTS)
    if(@RBT_NAVIGATION_MAP_IO@)
        find_dependency(yaml-cpp CONFIG)
        find_dependency(PNG)
        include("${CMAKE_CURRENT_LIST_DIR}/rbtNavigationMapIOTargets.cmake")
        set(rbt_navigation_map_io_FOUND TRUE)
    else()
        set(rbt_navigation_map_io_FOUND FALSE)
    endif()
endif()
if("config_io" IN_LIST rbt_navigation_FIND_COMPONENTS)
    if(@RBT_NAVIGATION_MAP_IO@)
        find_dependency(yaml-cpp CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/rbtNavigationConfigIOTargets.cmake")
        set(rbt_navigation_config_io_FOUND TRUE)
    else()
        set(rbt_navigation_config_io_FOUND FALSE)
    endif()
endif()
check_required_components(rbt_navigation)
